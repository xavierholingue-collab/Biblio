# Copiez ce fichier sous le nom « .env » et remplissez les trois valeurs.
# Ce fichier contient des secrets : ne le partagez pas, ne le versionnez pas.

# Mot de passe d'accès à l'application. Choisissez-en un long.
MOT_DE_PASSE=changez-moi-par-une-phrase-longue

# Signature des jetons de session. DOIT survivre au redemarrage : sans lui,
# chaque livraison deconnecterait tout le monde, en silence.
#   openssl rand -base64 48
# En production l'API REFUSE de demarrer s'il est absent. En local, elle
# accepte, en le disant, un secret volatil.
SECRET_SESSION=changez-moi-32-caracteres-au-minimum

# Bibliotheque ouverte par MOT_DE_PASSE.
TENANT_DEFAUT=xavier

# Mot de passe interne de la base de données. Aucune importance qu'il soit
# mémorisable : seul le conteneur de l'API s'en sert. Prenez du caractère aléatoire.
PGPASSWORD=changez-moi-aussi

# Clé de l'API Anthropic, obtenue sur https://console.anthropic.com
# Sans elle, l'application fonctionne mais les résumés et les recommandations
# renvoient une erreur explicite.
ANTHROPIC_API_KEY=

# Réglages optionnels
MODELE=claude-sonnet-5
PORT_WEB=8080
PGUSER=biblio
PGDATABASE=biblio

# --- Connexion par lien de courriel ---------------------------------------
#
# Sans ces variables, la demande de lien ecrit celui-ci DANS LE JOURNAL du
# serveur au lieu de l'envoyer. Pratique en local et en recette ; refuse en
# production, ou un lien de connexion en clair dans un journal serait une
# porte ouverte.
#
# COURRIEL_SERVICE : brevo | resend | journal
#
# Brevo en service depuis le 16/08/2026. Resend avait ete choisi le matin,
# puis ecarte le soir meme : son offre gratuite ne couvre qu'un domaine, et
# y-factor l'occupait deja. La bascule a coute ce mot, et rien d'autre.
COURRIEL_SERVICE=journal
COURRIEL_CLEF=
COURRIEL_EXPEDITEUR=biblio@exemple.fr

# L'adresse qui figure DANS le lien. Elle ne peut pas etre deduite de la
# requete : l'en-tete « Host » vient du client, et le lire reviendrait a
# laisser un inconnu choisir ou atterrit votre jeton de connexion.
# En local, laissez vide : l'hote de la requete suffit, faute de proxy.
ADRESSE_PUBLIQUE=
